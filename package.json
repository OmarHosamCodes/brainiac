{
  "name": "brainiac",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "@types/bun": "^1.3.4",
      "hono": "^4.8.2",
      "@orpc/server": "^1.12.2",
      "@orpc/openapi": "^1.12.2",
      "@orpc/zod": "^1.12.2",
      "better-auth": "1.5.5",
      "@orpc/client": "^1.12.2",
      "drizzle-orm": "^0.45.1",
      "@types/pg": "^8.16.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:portless": "turbo dev:portless",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @brainiac/db db:push",
    "db:studio": "turbo -F @brainiac/db db:studio",
    "db:generate": "turbo -F @brainiac/db db:generate",
    "db:migrate": "turbo -F @brainiac/db db:migrate",
    "db:seed": "turbo -F server db:seed --",
    "grant:lifetime-pro": "turbo -F server grant:lifetime-pro --",
    "db:start": "turbo -F @brainiac/db db:start",
    "db:watch": "turbo -F @brainiac/db db:watch",
    "db:stop": "turbo -F @brainiac/db db:stop",
    "db:down": "turbo -F @brainiac/db db:down",
    "test:api:bruno": "bunx --yes @usebruno/cli run tests/bruno/brainiac-api -r --env Local --tests-only",
    "test:api:bruno:auto": "bash scripts/run-bruno-api-tests.sh",
    "test:api:bruno:ci": "bash scripts/run-bruno-api-tests.sh --ci",
    "check": "oxlint && oxfmt --write",
    "check:unused": "knip --include dependencies,devDependencies,exports,files,types",
    "clean": "git clean -xdf .turbo node_modules temp",
    "clean:workspaces": "turbo clean"
  },
  "devDependencies": {
    "@brainiac/config": "workspace:*",
    "@types/bun": "^1.3.11",
    "knip": "6.1.0",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.57.0",
    "turbo": "^2.8.20",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@vue/devtools-api": "^8.0.7"
  },
  "packageManager": "bun@1.3.10"
}
