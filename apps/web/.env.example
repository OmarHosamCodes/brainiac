# Frontend Environment Configuration
# ====================================
# Nuxt frontend specific environment variables
# Copy this file: cp .env.example .env
# Then fill in your values

# ========== SERVER URL ==========
# Backend API URL that the frontend connects to
# Development: http://localhost:7000 (Traefik proxy routes to backend on 3000)
# This value is sent to the browser and used by all API calls
NUXT_PUBLIC_SERVER_URL="http://localhost:7000"
