# Environment Configuration for Brainiac
# ========================================
# Copy this file to create .env files in each app:
#   - cp .env.example apps/server/.env
#   - cp .env.example apps/web/.env
#
# IMPORTANT: NEVER commit .env files — they contain secrets and are .gitignored
# Each .env file can override these values per environment

# ========== DATABASE ==========
# PostgreSQL connection string
# Default (Docker): postgresql://postgres:password@localhost:5440/brainiac
DATABASE_URL="postgresql://postgres:password@localhost:5440/brainiac"

# ========== AUTHENTICATION ==========
# Better Auth secret key (used for JWT signing)
# Must be at least 32 characters. Generate with: openssl rand -hex 16
BETTER_AUTH_SECRET="your-secret-key-here-min-32-chars"

# Better Auth URL (public URL where browsers reach auth endpoints)
# Development: http://localhost:7001 (Vite proxies /api/auth to the API on :7000)
# Production: https://brainiac.school-of-marketing.com (web server proxies /api/auth to the API)
BETTER_AUTH_URL="http://localhost:7001"

# Google OAuth (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ========== CORS & FRONTEND ==========
# Allowed origin for CORS requests
# Development: http://localhost:7001 (where Nuxt dev server runs)
# Production: set to your deployed web app origin, e.g. https://web-brainiac.up.railway.app
CORS_ORIGIN="http://localhost:7001"
# Optional: comma-separated additional frontend origins, e.g. preview domains
CORS_ORIGINS=""

# Frontend server URL (used in frontend env)
# Set in apps/web/.env as VITE_PUBLIC_SERVER_URL (or legacy NUXT_PUBLIC_SERVER_URL)
VITE_PUBLIC_SERVER_URL="http://localhost:7000"
NUXT_PUBLIC_SERVER_URL="http://localhost:7000"

# ========== AI / LLM ==========
# OpenRouter API key for AI model access
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-your-key-here"

# ========== BILLING / PAYMENTS ==========
# Polar payment processing (optional, only needed for billing features)

# Polar API token for accessing payment API
POLAR_ACCESS_TOKEN="polar_oat_your-token-here"

# Polar webhook secret for validating webhooks
POLAR_WEBHOOK_SECRET="polar_whs_your-secret-here"

# Polar environment: "sandbox" for testing, "production" for real payments
POLAR_SERVER="sandbox"

# Polar product ID for "Pro" tier
POLAR_PRODUCT_PRO="bc88ffdc-8153-44c8-aad3-b1d0fdae446f"

# ========== S3-COMPATIBLE STORAGE ==========
# Used for agency task attachments. Do not commit real credentials.
S3_ENDPOINT="https://s3.example.com"
S3_REGION="auto"
S3_BUCKET="brainiac-task-attachments"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"

# ========== ENVIRONMENT ==========
# Runtime environment: "development", "production", or "test"
NODE_ENV="development"
