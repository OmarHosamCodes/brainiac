{
  "ignoreFiles": [
    ".agents/skills/impeccable/scripts/**",
    "packages/env/src/helpers.ts",
    "packages/workspace/src/tasks.test.ts"
  ],
  "ignoreIssues": {
    "apps/web/app/components/workspace/node/context.ts": ["exports", "types"],
    "apps/web/app/components/agency/agency-segments.ts": ["types"],
    "apps/web-start/src/layouts/app-layout.tsx": ["types"]
  },
  "workspaces": {
    "apps/web": {
      "entry": [
        "nuxt.config.ts",
        "app/app.vue",
        "app/pages/**/*.vue",
        "app/layouts/**/*.vue",
        "app/plugins/**/*.ts",
        "app/middleware/**/*.ts",
        "app/components/**/*.vue",
        "app/composables/**/*.ts",
        "app/utils/**/*.ts"
      ],
      "project": ["app/**/*.{ts,vue}"],
      "ignoreDependencies": ["@iconify-json/lucide", "@iconify-json/simple-icons"]
    },
    "apps/web-start": {
      "entry": [
        "vite.config.ts",
        "src/router.tsx",
        "src/routes/**/*.tsx",
        "src/components/**/*.tsx",
        "src/hooks/**/*.ts",
        "src/lib/**/*.ts",
        "src/providers/**/*.tsx",
        "src/stores/**/*.ts",
        "src/utils/**/*.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "vite.config.ts"],
      "ignoreDependencies": [
        "@brainiac/agent",
        "@tanstack/router-plugin",
        "tailwindcss",
        "vinxi"
      ]
    },
    "apps/server": {
      "entry": ["src/index.ts", "src/seed.ts", "tsdown.config.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/agent": {
      "entry": ["src/index.ts", "src/tools.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/api": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/auth": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/index.ts", "drizzle.config.ts"],
      "project": ["src/**/*.ts", "drizzle.config.ts"]
    },
    "packages/env": {
      "entry": ["src/server.ts", "src/web.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/workspace": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
